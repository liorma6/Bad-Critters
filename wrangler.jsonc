{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bad-critters",
  "main": "worker/index.js",
  "vars": { "GUMROAD_PRODUCT_ID": "igraNwrit43FLzFkjlV2bw==" },
  "ratelimits": [{ "name": "DUBBING_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "zoobluff.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/dubbing/*"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
